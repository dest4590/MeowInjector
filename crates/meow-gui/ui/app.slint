import "font.ttf";

global SkeetTheme {
    out property <color> bg: #0e0f12;
    out property <color> window-border: #282a33;
    out property <color> input-bg: #090a0d;
    out property <color> input-border: #262833;
    out property <color> item-hover: #191c24;

    out property <color> green: #96db37;
    out property <color> green-dim: #609121;
    out property <color> green-bg: #12180d;
    out property <color> green-border: #354e17;

    out property <color> red: #e04343;
    out property <color> red-bg: #1c0f10;
    out property <color> red-border: #52191b;

    out property <color> text: #dcdedf;
    out property <color> text-muted: #8e929d;
    out property <color> text-dim: #525663;
}

component SkeetButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> is-danger: false;
    in property <bool> enabled: true;
    callback clicked();

    background: !root.enabled ? #131419 : (
        btn-touch.pressed ? #20232c : (
        btn-touch.has-hover ? (root.primary ? #213312 : #1e2028) : (
        root.primary ? SkeetTheme.green-bg : (root.is-danger ? SkeetTheme.red-bg : #16171e))));
    border-width: 1px;
    border-color: !root.enabled ? SkeetTheme.input-border : (
        root.primary ? SkeetTheme.green-border : (root.is-danger ? SkeetTheme.red-border : SkeetTheme.input-border));

    btn-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: !root.enabled ? SkeetTheme.text-dim : (
            root.primary ? SkeetTheme.green : (root.is-danger ? SkeetTheme.red : SkeetTheme.text));
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SettingsToggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    callback toggled();

    height: 22px;

    HorizontalLayout {
        spacing: 8px;

        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            background: root.checked ? SkeetTheme.green : SkeetTheme.input-bg;
            border-width: 1px;
            border-color: root.checked ? SkeetTheme.green-border : SkeetTheme.input-border;

            Text {
                text: "✓";
                color: #0e0f12;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
                visible: root.checked;
            }
        }

        Text {
            text: root.label;
            color: SkeetTheme.text;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component MainWindow inherits Window {
    title: "meowinjector";

    width: 360px;
    height: 290px;

    background: SkeetTheme.bg;
    default-font-family: "Verdana";

    in property <[string]> process-names: [];
    in property <[int]> process-pids: [];
    in property <[string]> filtered-names: [];
    in property <[int]> filtered-pids: [];
    in property <[int]> filtered-indices: [];
    in property <[image]> filtered-icons: [];

    in-out property <string> game-status: "waiting!";
    in-out property <bool> game-found: false;
    in-out property <string> dll-hint: "no dll selected";
    in-out property <string> dll-path: "";
    in-out property <string> process-name: "";
    in-out property <int> process-pid: 0;
    in-out property <bool> inject-ready: false;
    in-out property <string> status-text: "";
    in-out property <bool> status-ok: true;
    in-out property <bool> injecting: false;
    in-out property <bool> mapping: false;
    in-out property <bool> driver-ok: false;
    in-out property <int> selected-index: -1;

    in-out property <bool> dropdown-open: false;
    in-out property <string> search-text: "";
    in-out property <[string]> recent-dlls: [];
    in-out property <bool> recents-open: false;
    in-out property <length> grad-x: 0px;

    in-out property <bool> settings-open: false;
    in-out property <bool> close-after-inject: false;
    in-out property <bool> minimize-to-tray: false;
    in-out property <bool> auto-map-driver: false;
    in-out property <bool> hide-system: false;
    in-out property <[int]> filtered-arch: [];

    callback inject-clicked();
    callback browse-dll();
    callback process-selected(int);
    callback filter-processes(string);
    callback refresh-processes();
    callback map-driver();
    callback recent-selected(string);
    callback save-settings();
    callback restart-as-admin();
    callback quit-app();

    in-out property <bool> not-admin: false;

    Rectangle {
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: SkeetTheme.window-border;

        clip: true;

        Rectangle {
            x: root.grad-x;
            y: 0;
            width: root.width * 2;
            height: 2px;
            background: @linear-gradient(90deg, #ff3b30 0%, #ff9500 7%, #ffcc00 14%, #96db37 21%, #00c7be 28%, #30b0c7 35%, #af52de 42%, #ff3b30 50%, #ff9500 57%, #ffcc00 64%, #96db37 71%, #00c7be 78%, #30b0c7 85%, #af52de 92%, #ff3b30 100%);
        }

        VerticalLayout {
            padding: 14px;
            padding-top: 12px;
            spacing: 12px;

            HorizontalLayout {
                height: 32px;
                alignment: start;
                spacing: 0px;

                Text {
                    text: "meow";
                    color: #ffffff;
                    font-size: 32px;
                    font-family: "Cute Cat";
                    font-weight: 800;
                    vertical-alignment: center;
                }

                Text {
                    text: "injector";
                    color: SkeetTheme.green;
                    font-size: 32px;
                    font-family: "Cute Cat";
                    font-weight: 800;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;

                    Text {
                        text: "\u{e713}";
                        font-family: "Segoe MDL2 Assets";
                        color: settings-touch.has-hover ? SkeetTheme.green : SkeetTheme.text-dim;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    settings-touch := TouchArea {
                        clicked => { root.settings-open = !root.settings-open; }
                    }
                }
            }

            Rectangle {
                height: 24px;
                background: root.driver-ok ? SkeetTheme.green-bg : SkeetTheme.red-bg;
                border-width: 1px;
                border-color: root.driver-ok ? SkeetTheme.green-border : SkeetTheme.red-border;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    Text {
                        text: root.driver-ok ? "kernel driver loaded" : (
                            root.mapping ? "mapping driver..." : "kernel driver unloaded");
                        color: root.driver-ok ? SkeetTheme.green : SkeetTheme.red;
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        vertical-stretch: 0;
                    }

                    if !root.driver-ok: Rectangle {
                        height: 100%;
                        vertical-stretch: 0;
                        horizontal-stretch: 1;

                        Rectangle {
                            width: 40px;
                            height: 16px;
                            background: map-touch.pressed ? #2a1515 : (
                                map-touch.has-hover ? #2a1a1a : SkeetTheme.red-bg);
                            border-width: 1px;
                            border-color: SkeetTheme.red-border;
                            border-radius: 3px;
                            y: (parent.height - self.height) / 2;
                            x: parent.width - self.width;

                            Text {
                                text: root.mapping ? "..." : "MAP";
                                color: SkeetTheme.red;
                                font-size: 8px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            map-touch := TouchArea {
                                enabled: !root.mapping;
                                clicked => { root.map-driver(); }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "process";
                    color: SkeetTheme.text;
                    font-size: 10px;
                    font-weight: 700;
                }

                proc-box-anchor := Rectangle {
                    height: 28px;
                    background: SkeetTheme.input-bg;
                    border-width: 1px;
                    border-color: root.dropdown-open ? SkeetTheme.green : SkeetTheme.input-border;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        Text {
                            text: ">";
                            color: SkeetTheme.green;
                            font-size: 11px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;

                            if !root.dropdown-open: Text {
                                text: root.process-name != "" ? root.process-name + " (PID: " + root.process-pid + ")" : "Search process...";
                                color: root.process-name != "" ? SkeetTheme.green : SkeetTheme.text-dim;
                                font-size: 10px;
                                vertical-alignment: center;
                                y: (parent.height - self.height) / 2;
                            }

                            proc-search-input := TextInput {
                                visible: root.dropdown-open;
                                text <=> root.search-text;
                                font-size: 10px;
                                color: SkeetTheme.text;
                                vertical-alignment: center;
                                single-line: true;
                                width: 100%;
                                height: 100%;

                                edited => {
                                    root.filter-processes(self.text);
                                }

                                accepted => {
                                    if (root.filtered-names.length > 0) {
                                        root.process-selected(root.filtered-indices[0]);
                                        root.selected-index = root.filtered-indices[0];
                                        root.game-found = true;
                                        root.dropdown-open = false;
                                        root.search-text = "";
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.dropdown-open ? "▲" : "▼";
                            color: root.dropdown-open ? SkeetTheme.green : SkeetTheme.text-dim;
                            font-size: 8px;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.dropdown-open = !root.dropdown-open;
                            if (root.dropdown-open) {
                                proc-search-input.focus();
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "dll";
                    color: SkeetTheme.text;
                    font-size: 10px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 6px;
                    height: 28px;

                    dll-box-anchor := Rectangle {
                        background: SkeetTheme.input-bg;
                        border-width: 1px;
                        border-color: SkeetTheme.input-border;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;

                            Text {
                                text: root.dll-hint;
                                color: root.dll-path != "" ? SkeetTheme.green : SkeetTheme.text-dim;
                                font-size: 10px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }

                    SkeetButton {
                        width: 70px;
                        text: "browse";
                        clicked => { root.browse-dll(); }
                    }

                    Rectangle {
                        width: 28px;
                        background: rec-touch.pressed ? #20232c : (
                            rec-touch.has-hover || root.recents-open ? #1e2028 : #16171e);
                        border-width: 1px;
                        border-color: root.recents-open ? SkeetTheme.green : SkeetTheme.input-border;

                        Text {
                            text: "▼";
                            color: root.recent-dlls.length > 0 ? SkeetTheme.text : SkeetTheme.text-dim;
                            font-size: 8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        rec-touch := TouchArea {
                            enabled: root.recent-dlls.length > 0;
                            clicked => { root.recents-open = !root.recents-open; }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            HorizontalLayout {
                spacing: 6px;
                height: 30px;

                SkeetButton {
                    horizontal-stretch: 2;
                    text: root.injecting ? "INJECTING..." : "INJECT";
                    primary: true;
                    enabled: root.inject-ready && !root.injecting;
                    clicked => { root.inject-clicked(); }
                }
            }

            if root.status-text != "": Rectangle {
                height: 22px;
                background: root.status-ok ? SkeetTheme.green-bg : SkeetTheme.red-bg;
                border-width: 1px;
                border-color: root.status-ok ? SkeetTheme.green-border : SkeetTheme.red-border;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    Text {
                        text: root.status-text;
                        color: root.status-ok ? SkeetTheme.green : SkeetTheme.red;
                        font-size: 9px;
                        font-weight: 700;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.settings-open: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clicked => { root.settings-open = false; }

        Rectangle {
            x: root.width - 200px - 8px;
            y: 40px;
            width: 200px;
            height: 160px;
            background: #090a0d;
            border-width: 1px;
            border-color: SkeetTheme.green-border;
            clip: true;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "settings";
                    color: SkeetTheme.green;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                }

                SettingsToggle {
                    label: "close after inject";
                    checked <=> root.close-after-inject;
                    toggled => { root.save-settings(); }
                }
                SettingsToggle {
                    label: "minimize to tray";
                    checked <=> root.minimize-to-tray;
                    toggled => { root.save-settings(); }
                }
                SettingsToggle {
                    label: "auto-map driver on start";
                    checked <=> root.auto-map-driver;
                    toggled => { root.save-settings(); }
                }
                SettingsToggle {
                    label: "hide system processes";
                    checked <=> root.hide-system;
                    toggled => { root.save-settings(); }
                }
            }
        }
    }

    if root.recents-open: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clicked => { root.recents-open = false; }

        Rectangle {
            x: dll-box-anchor.absolute-position.x;
            y: dll-box-anchor.absolute-position.y + dll-box-anchor.height + 1px;
            width: dll-box-anchor.width + 70px + 28px;
            height: min(root.recent-dlls.length * 24px + 20px, root.height - self.y - 10px);
            background: #090a0d;
            border-width: 1px;
            border-color: SkeetTheme.green-border;
            clip: true;

            VerticalLayout {
                Rectangle {
                    height: 18px;
                    background: #111318;

                    Text {
                        text: "recent dlls";
                        color: SkeetTheme.text-dim;
                        font-size: 8px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                        x: 8px;
                    }
                }

                for path in root.recent-dlls: Rectangle {
                    height: 24px;
                    background: rrow-touch.has-hover ? #17210e : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;

                        Text {
                            text: path;
                            color: rrow-touch.has-hover ? SkeetTheme.green : SkeetTheme.text;
                            font-size: 9px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    rrow-touch := TouchArea {
                        clicked => { root.recent-selected(path); }
                    }
                }
            }
        }
    }

    if root.dropdown-open: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clicked => { root.dropdown-open = false; }

        Rectangle {
            x: proc-box-anchor.absolute-position.x;
            y: proc-box-anchor.absolute-position.y + proc-box-anchor.height + 1px;
            width: proc-box-anchor.width;
            height: min(root.filtered-names.length * 24px + 20px, root.height - self.y - 10px);
            background: #090a0d;
            border-width: 1px;
            border-color: SkeetTheme.green-border;
            clip: true;

            VerticalLayout {
                Rectangle {
                    height: 18px;
                    background: #111318;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;

                        Text {
                            text: "matching processes";
                            color: SkeetTheme.text-dim;
                            font-size: 8px;
                            font-weight: 700;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: root.filtered-names.length + " found";
                            color: SkeetTheme.green;
                            font-size: 8px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            background: refresh-touch.has-hover ? #1a1d26 : transparent;
                            border-radius: 3px;

                            Text {
                                text: "\u{e72c}";
                                color: refresh-touch.has-hover ? SkeetTheme.green : SkeetTheme.text-dim;
                                font-family: "Segoe MDL2 Assets";
                                font-size: 10px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }

                            refresh-touch := TouchArea {
                                clicked => { root.refresh-processes(); }
                            }
                        }
                    }
                }

                if root.filtered-names.length > 0: Flickable {
                    viewport-height: root.filtered-names.length * 24px;

                    VerticalLayout {
                        for name[idx] in root.filtered-names: Rectangle {
                            height: 24px;
                            background: row-touch.has-hover ? #17210e : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;

                                if idx < root.filtered-icons.length && root.filtered-icons[idx] != @image-url(""): Image {
                                    source: root.filtered-icons[idx];
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: name;
                                    color: row-touch.has-hover ? SkeetTheme.green : SkeetTheme.text;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: "PID: " + root.filtered-pids[idx];
                                    color: row-touch.has-hover ? SkeetTheme.green-dim : SkeetTheme.text-dim;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }

                                if root.filtered-arch[idx] != 0: Text {
                                    text: root.filtered-arch[idx] == 1 ? "x64" : "x86";
                                    color: root.filtered-arch[idx] == 1 ? SkeetTheme.green : SkeetTheme.text-dim;
                                    font-size: 8px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            row-touch := TouchArea {
                                clicked => {
                                    root.process-selected(root.filtered-indices[idx]);
                                    root.selected-index = root.filtered-indices[idx];
                                    root.game-found = true;
                                    root.dropdown-open = false;
                                    root.search-text = "";
                                }
                            }
                        }
                    }
                }

                if root.filtered-names.length == 0: VerticalLayout {
                    alignment: center;
                    Text {
                        text: "no processes found";
                        color: SkeetTheme.text-dim;
                        font-size: 9px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    if root.not-admin: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000cc;

        Rectangle {
            width: 280px;
            height: 150px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: #090a0d;
            border-width: 1px;
            border-color: SkeetTheme.green-border;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: "admin required";
                    color: SkeetTheme.green;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "run as administrator to map the driver";
                    color: SkeetTheme.text-muted;
                    font-size: 9px;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    height: 28px;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: restart-touch.pressed ? #213312 : (
                            restart-touch.has-hover ? #1e2028 : SkeetTheme.green-bg);
                        border-width: 1px;
                        border-color: SkeetTheme.green-border;

                        HorizontalLayout {
                            spacing: 6px;
                            padding-left: 8px;
                            padding-right: 8px;

                            Text {
                                text: "\u{e7ef}";
                                font-family: "Segoe MDL2 Assets";
                                color: SkeetTheme.green;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "restart as admin";
                                color: SkeetTheme.green;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        restart-touch := TouchArea {
                            clicked => { root.restart-as-admin(); }
                        }
                    }

                    SkeetButton {
                        width: 70px;
                        text: "quit";
                        is-danger: true;
                        clicked => { root.quit-app(); }
                    }
                }
            }
        }
    }
}
